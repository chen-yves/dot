{
  // Core
  "editor.fontSize": 14,
  "editor.tabSize": 2,
  "editor.fontFamily": "'JetBrainsMono Nerd Font', 'Sarasa Term TC', Consolas, 'Courier New', monospace, Monaco",
  "editor.minimap.enabled": false,
  "editor.defaultColorDecorators": "always",
  "editor.codeLens": false,
  "editor.cursorBlinking": "solid",
  "editor.quickSuggestionsDelay": 50,
  "editor.hover.delay": 1000,
  "editor.guides.bracketPairs": false,
  "editor.renderWhitespace": "none",
  "editor.renderControlCharacters": false,
  "editor.smoothScrolling": false,
  "editor.cursorSmoothCaretAnimation": "off",
  "editor.matchBrackets": "near",
  "editor.formatOnSave": false,
  "editor.wordWrap": "off",
  "editor.folding": true,
  "editor.occurrencesHighlight": "off",
  "editor.semanticHighlighting.enabled": true,
  "extensions.autoCheckUpdates": false,
  "extensions.autoUpdate": "off",
  "extensions.ignoreRecommendations": true,
  "git.autorefresh": false,
  "window.zoomLevel": -0.7,
  "workbench.startupEditor": "none",
  "workbench.settings.editor": "json",
  "workbench.enableExperiments": false,
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.gpuAcceleration": "off",
  "terminal.integrated.minimumContrastRatio": 1,
  "terminal.integrated.scrollback": 1000,
  "telemetry.telemetryLevel": "off",
  "update.mode": "none",
  "scm.diffDecorations": "none",
  "window.titleBarStyle": "custom",
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/*.code-search": true,
    "**/dist": true,
    "**/build": true,
    "**/.git": true,
    "**/.next": true,
    "**/.venv": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/.next/**": true,
    "**/.venv/**": true
  },
  "extensions.experimental.affinity": {
    "vscodevim.vim": 1
  },
  // VSCodeVim
  "vim.leader": "<space>",
  "vim.hlsearch": true,
  "vim.showcmd": false,
  "vim.useSystemClipboard": true,
  "vim.highlightedyank.enable": true,
  "vim.highlightedyank.duration": 1000,
  "vim.insertModeKeyBindings": [
    {
      "before": [
        "j",
        "k"
      ],
      "after": [
        "<Esc>"
      ]
    }
  ],
  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "before": [
        "<leader>",
        "<leader>"
      ],
      "commands": [
        "workbench.action.showCommands"
      ],
    },
    {
      "before": [
        "<C-h>"
      ],
      "after": [
        "<C-w>",
        "h"
      ]
    },
    {
      "before": [
        "<C-j>"
      ],
      "after": [
        "<C-w>",
        "j"
      ]
    },
    {
      "before": [
        "<C-k>"
      ],
      "after": [
        "<C-w>",
        "k"
      ]
    },
    {
      "before": [
        "<C-l>"
      ],
      "after": [
        "<C-w>",
        "l"
      ]
    },
    {
      "before": [
        "<leader>",
        "f",
        "n"
      ],
      "commands": [
        "workbench.action.toggleSidebarVisibility"
      ]
    },
    {
      "before": [
        "<leader>",
        "f",
        "f"
      ],
      "commands": [
        "workbench.action.quickOpen"
      ]
    },
    {
      "before": [
        "<leader>",
        "f",
        "o"
      ],
      "commands": [
        "workbench.action.gotoSymbol"
      ]
    },
    {
      "before": [
        "<leader>",
        "f",
        "O"
      ],
      "commands": [
        "workbench.action.showAllSymbols"
      ]
    },
    {
      "before": [
        "<leader>",
        "f",
        "w"
      ],
      "commands": [
        "workbench.action.findInFiles"
      ]
    },
    {
      "before": [
        "<leader>",
        "t",
        "n"
      ],
      "commands": [
        "workbench.view.explorer"
      ]
    },
  ],
  // Catppuccin
  "workbench.colorTheme": "Catppuccin Mocha",
  "catppuccin.accentColor": "lavender",
  "catppuccin.colorOverrides": {
    "mocha": {
      "base": "#11111b",
      "mantle": "#11111b",
    },
  },
  "catppuccin.customUIColors": {
    "mocha": {
      "editorLineNumber.activeForeground": "green",
      "editorLineNumber.foreground": "surface1",
      "statusBar.foreground": "accent",
      "widget.border": "accent",
    },
  },
  "catppuccin.italicComments": true,
  "catppuccin.italicKeywords": true,
  "catppuccin.boldKeywords": true,
  "catppuccin.workbenchMode": "minimal",
  "catppuccin.extraBordersEnabled": true,
  "catppuccin.bracketMode": "dimmed",
  "catppuccin.syncWithIconPack": true,
  // Catppuccin Icon
  "workbench.iconTheme": "catppuccin-mocha",
  "catppuccin-icons.associations.extensions": {},
  "catppuccin-icons.associations.files": {},
  "catppuccin-icons.associations.folders": {},
  "catppuccin-icons.associations.languages": {},
  "catppuccin-icons.hidesExplorerArrows": false,
  "catppuccin-icons.monochrome": false,
  "catppuccin-icons.specificFolders": true,
}
